{
  "openapi": "3.1.0",
  "info": {
    "title": "Wealth Master API",
    "version": "0.1.0",
    "description": "Password login and financial account creation. MFA and registration are deferred."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/csrf": {
      "get": {
        "summary": "Obtain a fresh masked CSRF token",
        "security": [],
        "responses": {
          "200": {
            "description": "CSRF token bound to the session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Csrf"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Sign in with email and password",
        "description": "Uses Spring Security form login and rotates the session ID. Fetch a fresh CSRF token after authentication. Future MFA_REQUIRED challenges must not grant account access.",
        "security": [],
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Fresh masked token from GET /auth/csrf; include same-origin session cookie."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "CSRF check failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "summary": "Restore the current authenticated session",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Invalidate the session and clear its cookie",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Fresh masked token from GET /auth/csrf; include same-origin session cookie."
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "403": {
            "description": "CSRF check failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/accounts": {
      "get": {
        "summary": "List accounts owned by the authenticated user",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Accounts ordered newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create an account for the authenticated user",
        "description": "Ownership always comes from the session. Creation and its audit event are atomic.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Fresh masked token from GET /auth/csrf; include same-origin session cookie."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccount"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved financial account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "CSRF check failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "message"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "AUTHENTICATED"
            ]
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            },
            "required": [
              "id",
              "email"
            ]
          }
        },
        "required": [
          "status",
          "user"
        ]
      },
      "Csrf": {
        "type": "object",
        "properties": {
          "headerName": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "headerName",
          "token"
        ]
      },
      "CreateAccount": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "type": "string",
            "enum": [
              "CHECKING",
              "SAVINGS",
              "CASH",
              "CREDIT_CARD",
              "INVESTMENT",
              "OTHER"
            ]
          },
          "institution": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Valid ISO 4217 monetary currency."
          },
          "openingAmount": {
            "type": "string",
            "pattern": "^-?[0-9]{1,20}(\\.[0-9]{1,8})?$",
            "description": "Exact decimal string. Credit-card amount must be non-negative."
          },
          "balanceMeaning": {
            "type": "string",
            "enum": [
              "BALANCE",
              "AMOUNT_OWED",
              "IN_CREDIT"
            ],
            "description": "BALANCE for non-card accounts. AMOUNT_OWED is stored negative; IN_CREDIT positive."
          },
          "openingDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "name",
          "type",
          "currency",
          "openingAmount",
          "balanceMeaning",
          "openingDate"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "type": "string",
            "enum": [
              "CHECKING",
              "SAVINGS",
              "CASH",
              "CREDIT_CARD",
              "INVESTMENT",
              "OTHER"
            ]
          },
          "institution": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Valid ISO 4217 monetary currency."
          },
          "openingDate": {
            "type": "string",
            "format": "date"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "openingBalance": {
            "type": "string",
            "description": "Exact signed opening balance, not a current valuation."
          },
          "active": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "name",
          "type",
          "institution",
          "currency",
          "openingDate",
          "id",
          "openingBalance",
          "active",
          "createdAt"
        ]
      }
    }
  }
}
