        ]
      },
      "CreateAccount": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "type": "string",
            "enum": [
              "CHECKING",
              "SAVINGS",
              "CASH",
              "CREDIT_CARD",
              "INVESTMENT",
              "OTHER"
            ]
          },
          "institution": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Valid ISO 4217 monetary currency."
          },
          "openingAmount": {
            "type": "string",
            "pattern": "^-?[0-9]{1,20}(\\.[0-9]{1,8})?$",
            "description": "Exact decimal string. Credit-card amount must be non-negative."
          },
          "balanceMeaning": {
            "type": "string",
            "enum": [
              "BALANCE",
              "AMOUNT_OWED",
              "IN_CREDIT"
            ],
            "description": "BALANCE for non-card accounts. AMOUNT_OWED is stored negative; IN_CREDIT positive."
          },
          "openingDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "name",
          "type",
          "currency",
          "openingAmount",
          "balanceMeaning",
          "openingDate"
        ]
      },
