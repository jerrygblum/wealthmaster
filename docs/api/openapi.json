  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "retryAfterSeconds": {
            "type": "integer"
          }
        },
        "required": [
          "message"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "AUTHENTICATED",
              "MFA_REQUIRED",
              "MFA_SETUP_REQUIRED"
            ]
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            },
            "required": [
              "id",
              "email"
            ]
          },
          "recoveryUsed": {
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "user"
        ]
      },
      "Csrf": {
        "type": "object",
        "properties": {
