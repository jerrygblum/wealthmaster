# Copy to .env on the NAS. Never commit the populated file.
WEALTHMASTER_IMAGE_PREFIX=ghcr.io/jerrygblum/wealthmaster
# Copy sha-<full commit SHA> from a successful CI publishing job summary.
WEALTHMASTER_IMAGE_TAG=

POSTGRES_DB=wealthmaster
POSTGRES_USER=wealthmaster
# Generate a unique value: openssl rand -hex 32
POSTGRES_PASSWORD=

# Initial setup only. Remove these values after the owner is provisioned.
INITIAL_OWNER_EMAIL=
# Unique password: 12–72 characters, at most 72 UTF-8 bytes.
INITIAL_OWNER_PASSWORD=

# Generate ONCE and preserve with backups. Never regenerate during updates.
# openssl rand -hex 32
MFA_ENCRYPTION_PASSWORD=
# openssl rand -hex 16
MFA_ENCRYPTION_SALT=

APP_BUSINESS_TIME_ZONE=Europe/Zurich
