POSTGRES_DB=wealthmaster
POSTGRES_USER=wealthmaster
POSTGRES_PASSWORD=change-me-in-production
SPRING_PROFILES_ACTIVE=dev
VITE_API_BASE_URL=/api/v1

# Initial setup only: supply your email and a unique password (12–72 characters, at most 72 UTF-8 bytes).
# Existing users are never reset from these variables. Remove after setup.
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=
# false is for local HTTP development. Use true for production HTTPS.
SESSION_COOKIE_SECURE=false

# Generate once with `openssl rand -hex 32` and `openssl rand -hex 16`.
# Required in both dev/prod; preserve securely with your deployment configuration.
MFA_ENCRYPTION_PASSWORD=
MFA_ENCRYPTION_SALT=

# Business date validation; system/audit timestamps remain UTC.
APP_BUSINESS_TIME_ZONE=Europe/Zurich
